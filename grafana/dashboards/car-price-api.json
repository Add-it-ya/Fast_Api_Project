{
  "uid": "car-price-api",
  "title": "Car Price API",
  "tags": [
    "fastapi",
    "ml"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Service",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Throughput",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(predictions_total[1m]))",
          "legendFormat": "predictions/s"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Cache hit ratio",
      "description": "Share of predictions answered from Redis. Every miss is a model call.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.2
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(predictions_total{cache=\"hit\"}[5m])) / clamp_min(sum(rate(predictions_total[5m])), 0.001)",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Prediction p95",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 10,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(prediction_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "stat",
      "title": "5xx rate",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 15,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_requests_total{status=\"5xx\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_requests_total[5m])), 0.001)",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Model version",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(model_version)",
          "legendFormat": "version"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Prediction latency by cache outcome",
      "description": "A cache hit should sit near a millisecond. A miss carries the model call.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "pointSize": 6,
            "spanNulls": true
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(prediction_latency_seconds_bucket[5m])) by (le, cache))",
          "legendFormat": "p95 {{cache}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum(rate(prediction_latency_seconds_bucket[5m])) by (le, cache))",
          "legendFormat": "p50 {{cache}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Model inference time",
      "description": "Time inside the model only, separate from request overhead. Rising here means the model, not the service.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "pointSize": 6,
            "spanNulls": true
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(model_inference_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum(rate(model_inference_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "type": "row",
      "title": "Model health",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      }
    },
    {
      "type": "timeseries",
      "title": "Feature drift (PSI vs training)",
      "description": "Under 0.1 stable, 0.1-0.25 moderate, above 0.25 significant. Each worker keeps its own window, so expect one series per worker per feature.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "pointSize": 6,
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(model_feature_drift_psi) by (feature)",
          "legendFormat": "{{feature}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Live error vs training",
      "description": "Mean absolute error over predictions with a reported sale price. Flat at zero means no outcomes have been reported.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "pointSize": 6,
            "spanNulls": true
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(model_live_mae)",
          "legendFormat": "live MAE"
        },
        {
          "refId": "B",
          "expr": "71366",
          "legendFormat": "training MAE"
        }
      ]
    },
    {
      "type": "barchart",
      "title": "Predictions by company",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum(increase(predictions_total[30m])) by (company))",
          "legendFormat": "{{company}}",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Prediction log writer",
      "description": "Rows are queued and written in batches off the request path. Dropped rows mean the queue filled.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "pointSize": 6,
            "spanNulls": true
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(prediction_log_rows_written_total[5m]))",
          "legendFormat": "rows written/s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(prediction_log_rows_dropped_total[5m]))",
          "legendFormat": "rows dropped/s"
        },
        {
          "refId": "C",
          "expr": "sum(prediction_log_queue_depth)",
          "legendFormat": "queue depth"
        }
      ]
    }
  ]
}
